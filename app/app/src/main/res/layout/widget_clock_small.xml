<?xml version="1.0" encoding="utf-8"?>
<!-- Live clock for the home-screen widget. TextClock ticks on its own, so the
     time is always current even when the app is not running. Follows the
     phone's 12/24-hour setting. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextClock
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:includeFontPadding="false"
        android:textColor="#2E2A27"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextClock
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:format12Hour="EEE, d MMM"
        android:format24Hour="EEE, d MMM"
        android:includeFontPadding="false"
        android:textColor="#8C857D"
        android:textSize="11sp" />
</LinearLayout>
